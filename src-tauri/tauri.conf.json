{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Translator",
  "version": "1.0.0",
  "identifier": "com.universaltranslator.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main", "title": "Universal Translator",
        "width": 480, "height": 580, "minWidth": 340, "minHeight": 260,
        "decorations": false, "alwaysOnTop": true, "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
